{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/registry/main/docs/reference/server-json/draft/server.schema.json",
  "name": "io.github.yeongjunyoo/onprem-mcp-data",
  "description": "On-prem MCP server: routes one question into vector search, NL2SQL and knowledge graph, fuses results, answers with a local LLM.",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/yeongjunyoo/onprem-mcp-data",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yeongjunyoo/onprem-mcp-data#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "onprem-mcp-data",
      "version": "0.1.3",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "DATABASE_URL",
          "description": "PostgreSQL 16 + pgvector 접속 문자열. 예: postgresql://user:pass@localhost:5433/mcpdata",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "READ_DATABASE_URL",
          "description": "읽기 전용 replica 접속 문자열. 미설정 시 primary로 폴백한다.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "OLLAMA_HOST",
          "description": "로컬 Ollama 주소. 기본값 http://localhost:11434",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "OLLAMA_MODEL",
          "description": "답변 생성 모델 태그. 기본값 qwen2.5-coder:7b",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "EMBED_MODEL",
          "description": "임베딩 모델 태그. 기본값 bge-m3",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "DATASET",
          "description": "데이터 프로파일. companyx | bench | smoke",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
